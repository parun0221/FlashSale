NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://flashsale:flashsale@localhost:5432/flashsale
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-16-karakter
JWT_REFRESH_SECRET=ganti-dengan-string-acak-lain-minimal-16-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# Token bucket: capacity = ukuran burst, refill = token per detik
RATE_LIMIT_IP_CAPACITY=200
RATE_LIMIT_IP_REFILL_PER_SEC=100
RATE_LIMIT_ORDER_CAPACITY=5
RATE_LIMIT_ORDER_REFILL_PER_SEC=1

ORDER_QUEUE_CONCURRENCY=20
